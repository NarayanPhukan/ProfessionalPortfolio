rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: public read, authenticated admin write
    match /profile/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Projects: public read, authenticated admin write
    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Skills: public read, authenticated admin write
    match /skills/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contact messages: public create (send message), authenticated admin read/update/delete
    match /contacts/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Error reports & crash telemetry: public create, authenticated admin read/update/delete
    match /error_reports/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
